Example 1:
Input: nums = [1, 2, 3, 4]

Output: [4, 3, 2, 1]

Example 2:
Input: nums = [-3, -1, -2, -5, -4]

Output: [-4, -5, -2, -1, -3]


class Solution {
    public int[] reverseArray(int[] nums) {

        int left=0;
        int right=nums.length-1;

        while(left<right){

            int temp=nums[left];
            nums[left]=nums[right];
            nums[right]=temp;

            left++;
            right--;
        }  
        return nums;      
    }
}
