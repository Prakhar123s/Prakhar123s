Example 1:
Input: nums = [1, 2, 3, 4]

Output: [2, 2]

Example 2:
Input: nums = [-3, -2, 0]

Output: [2, 1]


class Solution {
    public int[] countEvenOdd(int[] nums) {

    int evenCount=0;
    int oddCount=0;
    
     for(int i=0;i<nums.length;i++){

        if(nums[i]%2==0 || nums[i]==0){

            evenCount++;
        }
        else 
            oddCount++;
     }
     return new int[] { evenCount, oddCount};   
    }
}
