Example 1:
Input: nums = [1, 2, 2, 3]

Output: true

Example 2:
Input: nums = [3, 1, 2]

Output: false


class Solution {
    public boolean isSorted(int[] nums) {

        int i=0;

        int j=i+1;

        while(i<nums.length && j<nums.length){

            if(nums[i]>nums[j]){

                return false;

            }
            i++;
            j++;
        }
        return true;
        
    }
}
